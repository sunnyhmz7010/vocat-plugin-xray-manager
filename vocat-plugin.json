{
  "schema_version": 1,
  "id": "xray-manager",
  "name": "Xray管理",
  "version": "1.4.0",
  "description": "粘贴 VLESS、VMess、Trojan、Shadowsocks 或 Hysteria 2（hy2）链接，启动内置 Xray，可选择推送到 VoCat 上游代理。",
  "permissions": [
    "process.spawn",
    "network.connect",
    "proxy.write"
  ],
  "contributions": [
    {
      "id": "panel",
      "label": "Xray管理",
      "label_zh": "Xray管理",
      "location": "sidebar",
      "after": "proxy",
      "entry": "web/panel.html"
    }
  ],
  "backend": {
    "commands": {
      "linux/amd64": "bin/xray-manager",
      "linux/arm64": "bin/xray-manager"
    }
  }
}
